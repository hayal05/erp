# Copy this file to .env at the REPOSITORY ROOT for local development.
# Backend dev/seed/migrate scripts read root .env; Vite reads root .env too.
# Do not commit .env or place credentials in any VITE_ variable.

# ---- API runtime ----
# Local: development. Render sets production in render.yaml.
# NODE_ENV defaults to development locally; Render supplies NODE_ENV=production.
# Local API port. Render supplies PORT automatically; do not pin it in the Blueprint.
PORT=4000
# Local direct PostgreSQL URL. On Render use Neon's pooled runtime URL with sslmode=require.
DATABASE_URL=postgresql://natra:replace-with-local-password@127.0.0.1:5432/natra
# Render startup migrations use the DIRECT (non-pooler) URL for session advisory locks.
# Point this at the SAME database as DATABASE_URL. Keep sslmode=require for Neon.
# Local npm run migrate uses DATABASE_URL; this separate URL is used by the Render start command.
MIGRATION_DATABASE_URL=postgresql://natra:replace-with-local-password@127.0.0.1:5432/natra
# Exact browser origin, no path. Local dev: the Vite origin below. On Render leave it unset: the app and API are
# one service and the API defaults to RENDER_EXTERNAL_URL. Set it only for a custom domain.
FRONTEND_URL=http://localhost:5173
# Set a fresh random value of at least 32 characters before running locally.
# Generate with Node crypto.randomBytes(48).toString("hex").
# Render generates this automatically; do not supply a fixed production default.
SESSION_SECRET=
COMPANY_TIMEZONE=Africa/Addis_Ababa
COMPANY_NAME=Natra
# lax for local and for the single-service Render deployment (same origin). none is only for a legacy split
# deployment on two cross-site HTTPS hosts (Secure required; browsers may block those third-party cookies).
COOKIE_SAMESITE=lax
# QR token lifetime is fixed at 45 seconds in the service; there is no TTL environment override.

# ---- Private Cloudinary storage (backend only) ----
# Needed for live selfie upload/view/delete. Blank values allow the app to boot but disable photo storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- One-off first HR administrator setup (not automatic on every deploy) ----
# Optional for existing installations: omitted username falls back to SEED_ADMIN_EMAIL.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=hr@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HR Administrator

# ---- Frontend PUBLIC build-time setting ----
# Local dev only (Vite on :5173 calls the API on :4000). Do NOT set it on Render: empty means the frontend
# calls the same origin that served it, which is how the single-service deployment works.
VITE_API_URL=http://localhost:4000

# ---- Tests only: dedicated disposable database; name MUST contain "test" ----
# TEST_DATABASE_URL=postgresql://natra:replace-with-test-password@127.0.0.1:5432/natra_test

# Render runtime selection is pinned in .node-version and render.yaml (NODE_VERSION=24).
